<?xml version="1.0" encoding="utf-8"?>
<!-- Backup and device transfer rules for Android 12 and newer. -->
<data-extraction-rules>
    <cloud-backup>
        <!-- Only the projects database. The watch switch in shared preferences is per device. -->
        <include domain="database" path="knitting.db" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="knitting.db" />
    </device-transfer>
</data-extraction-rules>
